{
  "name": "Alert Event",
  "module": "Fleet Service",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 0,
  "description": "A log of every alert the engine fired (the same ones posted to Teams). One row per incident-fire — used for dashboards, charts and reporting.",
  "fields": [
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "alert_type",
      "label": "Alert Type",
      "fieldtype": "Link",
      "options": "Alert Type",
      "in_standard_filter": 1,
      "read_only": 1
    },
    {
      "fieldname": "severity",
      "label": "Severity",
      "fieldtype": "Select",
      "options": "warning\ncritical",
      "in_standard_filter": 1,
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Open\nAcknowledged\nResolved",
      "default": "Open",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "triggered_at",
      "label": "Triggered At (IST)",
      "fieldtype": "Datetime",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "column_break_ae1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "vehicle",
      "label": "Vehicle",
      "fieldtype": "Link",
      "options": "Vehicle",
      "in_standard_filter": 1,
      "read_only": 1
    },
    {
      "fieldname": "registration_number",
      "label": "Vehicle Number",
      "fieldtype": "Data",
      "in_list_view": 1,
      "columns": 2,
      "read_only": 1
    },
    {
      "fieldname": "device_id",
      "label": "Device ID",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "customer",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer",
      "in_standard_filter": 1,
      "read_only": 1
    },
    {
      "fieldname": "channel",
      "label": "Teams Channel",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "section_reading",
      "label": "Reading",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "parameter",
      "label": "Parameter",
      "fieldtype": "Data",
      "in_standard_filter": 1,
      "read_only": 1
    },
    {
      "fieldname": "op",
      "label": "Operator",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "value",
      "label": "Value",
      "fieldtype": "Float",
      "read_only": 1
    },
    {
      "fieldname": "value_text",
      "label": "Value (text)",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "unit",
      "label": "Unit",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "column_break_ae2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "threshold",
      "label": "Threshold",
      "fieldtype": "Float",
      "read_only": 1
    },
    {
      "fieldname": "match_value",
      "label": "Match Value",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "message",
      "label": "Message",
      "fieldtype": "Small Text",
      "in_list_view": 1,
      "columns": 4,
      "read_only": 1
    },
    {
      "fieldname": "details",
      "label": "Readings",
      "fieldtype": "Small Text",
      "read_only": 1,
      "description": "Extra readings captured at the time of the alert (display parameters)."
    },
    {
      "fieldname": "section_location",
      "label": "Location & Timing",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "latitude",
      "label": "Latitude",
      "fieldtype": "Float",
      "precision": "6",
      "read_only": 1
    },
    {
      "fieldname": "longitude",
      "label": "Longitude",
      "fieldtype": "Float",
      "precision": "6",
      "read_only": 1
    },
    {
      "fieldname": "maps_link",
      "label": "Maps Link",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "column_break_ae3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "occurred_at",
      "label": "Reading Time (IST)",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "job_card",
      "label": "Job Card",
      "fieldtype": "Link",
      "options": "Job Card",
      "description": "Job Card raised from this alert, if any."
    },
    {
      "fieldname": "dedup_key",
      "label": "Dedup Key",
      "fieldtype": "Data",
      "read_only": 1,
      "description": "device_id:rule_id — groups repeats of the same vehicle+alert."
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Central Ops", "read": 1, "write": 1, "create": 1},
    {"role": "Depot Manager", "read": 1},
    {"role": "Customer", "read": 1, "if_owner": 0}
  ],
  "sort_field": "triggered_at",
  "sort_order": "DESC",
  "title_field": "title"
}
