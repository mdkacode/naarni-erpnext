{
  "name": "Job Card Item",
  "module": "Fleet Service",
  "doctype": "DocType",
  "document_type": "",
  "istable": 1,
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "item_description",
      "label": "Description",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "item_type",
      "label": "Type",
      "fieldtype": "Select",
      "options": "\nPart\nLabour\nConsumable\nExternal Service",
      "in_list_view": 1
    },
    {
      "fieldname": "qty",
      "label": "Qty",
      "fieldtype": "Float",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "rate",
      "label": "Rate",
      "fieldtype": "Currency",
      "in_list_view": 1
    },
    {
      "fieldname": "estimated_amount",
      "label": "Estimated Amount",
      "fieldtype": "Currency",
      "in_list_view": 1
    },
    {
      "fieldname": "actual_amount",
      "label": "Actual Amount",
      "fieldtype": "Currency",
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_item1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "part_number",
      "label": "Part Number",
      "fieldtype": "Data"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "\nPending\nOrdered\nReceived\nFitted",
      "default": "Pending"
    },
    {
      "fieldname": "notes",
      "label": "Notes",
      "fieldtype": "Small Text"
    }
  ],
  "permissions": []
}
