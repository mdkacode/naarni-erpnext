{
  "name": "Service Contract",
  "module": "Fleet Service",
  "doctype": "DocType",
  "allow_import": 1,
  "document_type": "Document",
  "engine": "InnoDB",
  "autoname": "field:contract_name",
  "naming_rule": "By fieldname",
  "fields": [
    {
      "fieldname": "contract_name",
      "label": "Contract Name",
      "fieldtype": "Data",
      "unique": 1,
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "customer",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "start_date",
      "label": "Start Date",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "fieldname": "end_date",
      "label": "End Date",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "fieldname": "section_sla",
      "label": "SLA Overrides",
      "fieldtype": "Section Break",
      "collapsible": 1
    },
    {
      "fieldname": "pms_tat_hours",
      "label": "PMS TAT (Hours)",
      "fieldtype": "Float",
      "default": "4"
    },
    {
      "fieldname": "repair_tat_hours",
      "label": "Repair TAT (Hours)",
      "fieldtype": "Float",
      "default": "4"
    },
    {
      "fieldname": "column_break_sla",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "breakdown_tat_hours",
      "label": "Breakdown Remote TAT (Hours)",
      "fieldtype": "Float",
      "default": "0.5",
      "description": "Target for remote resolution before travel is required"
    },
    {
      "fieldname": "breakdown_onsite_tat_hours",
      "label": "Breakdown On-site TAT (Hours)",
      "fieldtype": "Float",
      "default": "4",
      "description": "Target from SE arrival to vehicle handover"
    },
    {
      "fieldname": "software_tat_hours",
      "label": "Software Update TAT (Hours)",
      "fieldtype": "Float",
      "default": "3"
    }
  ],
  "permissions": [
    {
      "role": "Depot Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Service Engineer",
      "read": 1
    },
    {
      "role": "Central Ops",
      "read": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
