{
  "name": "Push Token",
  "module": "Fleet Service",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "hash",
  "description": "A device push token (FCM/APNs/Expo) registered by a user's App install, used to deliver push notifications.",
  "fields": [
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "device_token",
      "label": "Device Token",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "platform",
      "label": "Platform",
      "fieldtype": "Select",
      "options": "android\nios\nweb",
      "in_list_view": 1
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
