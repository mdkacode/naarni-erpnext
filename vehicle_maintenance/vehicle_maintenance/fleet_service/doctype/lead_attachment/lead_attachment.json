{
  "name": "Lead Attachment",
  "module": "Fleet Service",
  "doctype": "DocType",
  "istable": 1,
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "file_url",
      "label": "File",
      "fieldtype": "Attach",
      "reqd": 1,
      "in_list_view": 1,
      "description": "File URL from the Frappe File DocType (uploaded via /api/method/upload_file)."
    },
    {
      "fieldname": "caption",
      "label": "Caption",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "uploaded_by",
      "label": "Uploaded By",
      "fieldtype": "Link",
      "options": "User",
      "default": "__user",
      "read_only": 1
    },
    {
      "fieldname": "uploaded_on",
      "label": "Uploaded On",
      "fieldtype": "Datetime",
      "default": "Now",
      "read_only": 1
    }
  ]
}
