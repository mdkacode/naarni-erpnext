{
  "name": "VM Daily Status",
  "module": "Fleet Service",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "description": "One row per person per day: everything they said in their status chat that day, organised. The chat is where it is written; this is where it is read.",
  "fields": [
    {
      "fieldname": "sb_who",
      "label": "Who and When",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "search_index": 1
    },
    {
      "fieldname": "employee_name",
      "label": "Name",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status_date",
      "label": "Date",
      "fieldtype": "Date",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "search_index": 1
    },
    {
      "fieldname": "col_break_who",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "depot",
      "label": "Depot",
      "fieldtype": "Link",
      "options": "Depot",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "state",
      "label": "State",
      "fieldtype": "Select",
      "options": "Not Reported\nGenerated\nReviewed\nSent",
      "default": "Not Reported",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "Not Reported means the person said nothing that day. It is still a row, because a silent day is the thing a manager most needs to see."
    },
    {
      "fieldname": "sb_summary",
      "label": "Summary",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "summary_line",
      "label": "In One Line",
      "fieldtype": "Small Text",
      "in_list_view": 1
    },
    {
      "fieldname": "items",
      "label": "Items",
      "fieldtype": "Table",
      "options": "VM Daily Status Item"
    },
    {
      "fieldname": "sb_source",
      "label": "Source",
      "fieldtype": "Section Break",
      "description": "The messages this summary was built from. Ordering is by chat sequence, never by timestamp, so nothing is ever counted twice or skipped."
    },
    {
      "fieldname": "room",
      "label": "Status Room",
      "fieldtype": "Link",
      "options": "VM Chat Room",
      "read_only": 1
    },
    {
      "fieldname": "from_seq",
      "label": "From Seq",
      "fieldtype": "Int",
      "read_only": 1,
      "description": "Exclusive. Picks up where the previous day's row stopped, so a message sent after last night's digest is carried into this one rather than lost."
    },
    {
      "fieldname": "to_seq",
      "label": "To Seq",
      "fieldtype": "Int",
      "read_only": 1,
      "description": "Inclusive."
    },
    {
      "fieldname": "col_break_source",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "message_count",
      "label": "Messages",
      "fieldtype": "Int",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "voice_count",
      "label": "Voice Notes",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "photo_count",
      "label": "Photos",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "raw_transcript",
      "label": "What They Said",
      "fieldtype": "Text",
      "read_only": 1,
      "description": "The day's messages verbatim. The summary is a convenience; this is the record."
    },
    {
      "fieldname": "sb_ai",
      "label": "Generation",
      "fieldtype": "Section Break",
      "collapsible": 1
    },
    {
      "fieldname": "generated_by",
      "label": "Generated By",
      "fieldtype": "Select",
      "options": "AI\nFallback\nManual",
      "default": "Fallback",
      "read_only": 1,
      "in_standard_filter": 1,
      "description": "Fallback means the day was rendered from the raw messages without AI — because ONYX was off, unreachable, or replied with something that did not parse."
    },
    {
      "fieldname": "generated_at",
      "label": "Generated At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "generation_note",
      "label": "Note",
      "fieldtype": "Small Text",
      "read_only": 1,
      "description": "Why the fallback was used, when it was."
    },
    {
      "fieldname": "col_break_ai",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "email_sent_at",
      "label": "Included In Digest At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "indexed_at",
      "label": "Indexed In ONYX At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "ai_raw_response",
      "label": "Raw AI Response",
      "fieldtype": "Code",
      "options": "JSON",
      "read_only": 1,
      "description": "Kept for debugging the prompt. Never read by any code path."
    },
    {
      "fieldname": "dedup_key",
      "label": "Dedup Key",
      "fieldtype": "Data",
      "read_only": 1,
      "unique": 1,
      "hidden": 1,
      "description": "user::date — the uniqueness the generator relies on to stay idempotent."
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Central Ops", "read": 1, "write": 1},
    {"role": "Depot Manager", "read": 1, "write": 1},
    {"role": "N. Maintenance Head", "read": 1},
    {"role": "Service Engineer", "read": 1},
    {"role": "Technician", "read": 1},
    {"role": "Aftersales Eng", "read": 1}
  ],
  "sort_field": "status_date",
  "sort_order": "DESC"
}
