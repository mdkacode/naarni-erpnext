{
  "name": "Lead Status",
  "module": "Fleet Service",
  "doctype": "DocType",
  "allow_import": 1,
  "document_type": "Document",
  "engine": "InnoDB",
  "autoname": "field:status_name",
  "naming_rule": "By fieldname",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "status_name",
      "label": "Status Name",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "stage",
      "label": "Stage",
      "fieldtype": "Select",
      "options": "\nOpen\nWorking\nWon\nLost\nOn Hold",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Coarse bucket used for reporting and list filters."
    },
    {
      "fieldname": "display_order",
      "label": "Display Order",
      "fieldtype": "Int",
      "default": "0"
    },
    {
      "fieldname": "is_terminal",
      "label": "Is Terminal",
      "fieldtype": "Check",
      "default": "0",
      "description": "Terminal statuses (Won / Lost) cannot be advanced."
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1},
    {"role": "Sales Executive", "read": 1},
    {"role": "Central Ops", "read": 1},
    {"role": "Service Engineer", "read": 1}
  ],
  "sort_field": "display_order",
  "sort_order": "ASC"
}
