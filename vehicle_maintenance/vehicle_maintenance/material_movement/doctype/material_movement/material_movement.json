{
 "name": "Material Movement",
 "module": "Material Movement",
 "doctype": "DocType",
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "track_changes": 1,
 "description": "One gate event: everything that entered or left a plant on one truck, at one time, recorded by one person. This is a movement record, not a stock ledger - it says what moved, never what is on hand.",
 "field_order": [
  "naming_series", "movement_type", "location", "gate",
  "column_break_status", "status", "purpose", "client_uuid", "is_test",
  "sb_party", "party_type", "party_name",
  "column_break_party", "reference_type", "reference_no", "reference_date",
  "sb_transport", "transport_vehicle_no", "driver_name", "driver_phone",
  "column_break_context", "vehicle", "job_card",
  "sb_items", "items",
  "sb_photos", "photos",
  "sb_rollups", "total_items", "total_qty", "photo_count",
  "column_break_counts", "qr_count", "damaged_count", "new_item_count", "evidence_pct",
  "sb_people", "started_by", "started_at", "submitted_by", "submitted_at",
  "column_break_people", "verified_by", "verified_at", "completed_at",
  "sb_geo", "latitude", "longitude", "geofence_status",
  "sb_notes", "remarks", "rejection_reason"
 ],
 "fields": [
  {"fieldname": "naming_series", "label": "Series", "fieldtype": "Select", "options": "MM-.YYYY.-.#####", "default": "MM-.YYYY.-.#####", "reqd": 1},
  {"fieldname": "movement_type", "label": "Movement Type", "fieldtype": "Select", "options": "Inward\nOutward", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1},
  {"fieldname": "location", "label": "Location", "fieldtype": "Link", "options": "Material Location", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1},
  {"fieldname": "gate", "label": "Gate", "fieldtype": "Data"},
  {"fieldname": "column_break_status", "fieldtype": "Column Break"},
  {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Draft\nIn Progress\nAwaiting Verification\nCompleted\nCancelled", "default": "Draft", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1},
  {"fieldname": "purpose", "label": "Purpose", "fieldtype": "Select", "options": "\nSupplier Delivery\nInter-Plant Transfer In\nReturn from Job Work\nCustomer Return\nRework Return\nInter-Plant Transfer Out\nReturn to Supplier\nDispatch to Customer\nJob Work Out\nScrap / Disposal\nSample / Trial", "in_list_view": 1},
  {"fieldname": "client_uuid", "label": "Client UUID", "fieldtype": "Data", "unique": 1, "read_only": 1, "description": "Idempotency key. A phone that loses signal mid-create and retries gets the same document back, not a second one."},
  {"fieldname": "is_test", "label": "Test Movement", "fieldtype": "Check", "description": "Excluded from every report. Gives training a place to happen that is not the real register."},

  {"fieldname": "sb_party", "fieldtype": "Section Break", "label": "Counterparty & Document"},
  {"fieldname": "party_type", "label": "Party Type", "fieldtype": "Select", "options": "\nSupplier\nCustomer\nInter-Plant\nJob Work\nTransporter\nInternal"},
  {"fieldname": "party_name", "label": "Party Name", "fieldtype": "Data", "in_list_view": 1},
  {"fieldname": "column_break_party", "fieldtype": "Column Break"},
  {"fieldname": "reference_type", "label": "Document Type", "fieldtype": "Select", "options": "\nInvoice\nDelivery Challan\nE-Way Bill\nPurchase Order\nGate Pass\nOther"},
  {"fieldname": "reference_no", "label": "Document No", "fieldtype": "Data", "search_index": 1},
  {"fieldname": "reference_date", "label": "Document Date", "fieldtype": "Date"},

  {"fieldname": "sb_transport", "fieldtype": "Section Break", "label": "Transport & Context"},
  {"fieldname": "transport_vehicle_no", "label": "Truck Number", "fieldtype": "Data", "search_index": 1},
  {"fieldname": "driver_name", "label": "Driver Name", "fieldtype": "Data"},
  {"fieldname": "driver_phone", "label": "Driver Phone", "fieldtype": "Data"},
  {"fieldname": "column_break_context", "fieldtype": "Column Break"},
  {"fieldname": "vehicle", "label": "For Bus", "fieldtype": "Link", "options": "Vehicle", "description": "Optional. Set when the material is earmarked for one bus."},
  {"fieldname": "job_card", "label": "Against Job Card", "fieldtype": "Link", "options": "Job Card"},

  {"fieldname": "sb_items", "fieldtype": "Section Break", "label": "Items"},
  {"fieldname": "items", "label": "Items", "fieldtype": "Table", "options": "Material Movement Item"},

  {"fieldname": "sb_photos", "fieldtype": "Section Break", "label": "Photos"},
  {"fieldname": "photos", "label": "Photos", "fieldtype": "Table", "options": "Material Movement Photo"},

  {"fieldname": "sb_rollups", "fieldtype": "Section Break", "label": "Totals"},
  {"fieldname": "total_items", "label": "Item Rows", "fieldtype": "Int", "read_only": 1, "in_list_view": 1},
  {"fieldname": "total_qty", "label": "Total Quantity", "fieldtype": "Float", "read_only": 1, "precision": "3"},
  {"fieldname": "photo_count", "label": "Photos", "fieldtype": "Int", "read_only": 1},
  {"fieldname": "column_break_counts", "fieldtype": "Column Break"},
  {"fieldname": "qr_count", "label": "Serials Recorded", "fieldtype": "Int", "read_only": 1},
  {"fieldname": "damaged_count", "label": "Not OK", "fieldtype": "Int", "read_only": 1},
  {"fieldname": "new_item_count", "label": "Items Created at the Gate", "fieldtype": "Int", "read_only": 1},
  {"fieldname": "evidence_pct", "label": "Evidence", "fieldtype": "Percent", "read_only": 1, "description": "Share of item rows carrying at least one photo. The number a supervisor reads before verifying - and what lets the photo rule stay advisory without the record quietly rotting."},

  {"fieldname": "sb_people", "fieldtype": "Section Break", "label": "People & Times"},
  {"fieldname": "started_by", "label": "Recorded By", "fieldtype": "Link", "options": "User", "read_only": 1},
  {"fieldname": "started_at", "label": "Started At", "fieldtype": "Datetime", "read_only": 1},
  {"fieldname": "submitted_by", "label": "Submitted By", "fieldtype": "Link", "options": "User", "read_only": 1},
  {"fieldname": "submitted_at", "label": "Submitted At", "fieldtype": "Datetime", "read_only": 1},
  {"fieldname": "column_break_people", "fieldtype": "Column Break"},
  {"fieldname": "verified_by", "label": "Verified By", "fieldtype": "Link", "options": "User", "read_only": 1},
  {"fieldname": "verified_at", "label": "Verified At", "fieldtype": "Datetime", "read_only": 1},
  {"fieldname": "completed_at", "label": "Completed At", "fieldtype": "Datetime", "read_only": 1},

  {"fieldname": "sb_geo", "fieldtype": "Section Break", "label": "Where"},
  {"fieldname": "latitude", "label": "Latitude", "fieldtype": "Float", "precision": "6", "read_only": 1},
  {"fieldname": "longitude", "label": "Longitude", "fieldtype": "Float", "precision": "6", "read_only": 1},
  {"fieldname": "geofence_status", "label": "Geofence", "fieldtype": "Select", "options": "Unknown\nInside\nOutside", "default": "Unknown", "read_only": 1},

  {"fieldname": "sb_notes", "fieldtype": "Section Break", "label": "Notes"},
  {"fieldname": "remarks", "label": "Remarks", "fieldtype": "Text"},
  {"fieldname": "rejection_reason", "label": "Rejection Reason", "fieldtype": "Small Text", "read_only": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1, "print": 1, "email": 1},
  {"role": "Depot Manager", "read": 1, "write": 1, "create": 1, "export": 1, "report": 1, "print": 1},
  {"role": "Material Supervisor", "read": 1, "write": 1, "create": 1, "export": 1, "report": 1, "print": 1},
  {"role": "Material Gate Operator", "read": 1, "write": 1, "create": 1},
  {"role": "Material Viewer", "read": 1, "export": 1, "report": 1, "print": 1}
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "title_field": "party_name",
 "search_fields": "movement_type,location,party_name,reference_no,transport_vehicle_no"
}
