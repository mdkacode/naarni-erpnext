{
  "name": "Push Delivery",
  "module": "Fleet Service",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "hash",
  "description": "One row per (notification, device) push attempt. The durable ledger behind the retry sweeper: a push is only 'delivered' once FCM has accepted it for a specific token.",
  "fields": [
    {"fieldname": "user", "label": "User", "fieldtype": "Link", "options": "User", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1},
    {"fieldname": "device_token", "label": "Device Token", "fieldtype": "Small Text", "reqd": 1},
    {"fieldname": "push_token", "label": "Push Token", "fieldtype": "Link", "options": "Push Token"},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Queued\nSending\nSent\nRetrying\nDead", "default": "Queued", "in_list_view": 1, "in_standard_filter": 1, "search_index": 1},
    {"fieldname": "priority", "label": "Priority", "fieldtype": "Data", "in_list_view": 1},
    {"fieldname": "urgent", "label": "Urgent", "fieldtype": "Check", "default": "0", "description": "Warning/critical class. Drives HIGH FCM priority and SMS fallback."},
    {"fieldname": "col_1", "fieldtype": "Column Break"},
    {"fieldname": "attempts", "label": "Attempts", "fieldtype": "Int", "default": "0", "in_list_view": 1},
    {"fieldname": "next_attempt_at", "label": "Next Attempt At", "fieldtype": "Datetime", "search_index": 1},
    {"fieldname": "sent_at", "label": "Sent At", "fieldtype": "Datetime"},
    {"fieldname": "fcm_message_id", "label": "FCM Message ID", "fieldtype": "Data"},
    {"fieldname": "last_error", "label": "Last Error", "fieldtype": "Small Text"},
    {"fieldname": "fallback_sent", "label": "SMS Fallback Sent", "fieldtype": "Check", "default": "0"},
    {"fieldname": "sec_payload", "label": "Payload", "fieldtype": "Section Break"},
    {"fieldname": "title", "label": "Title", "fieldtype": "Data", "length": 255},
    {"fieldname": "body", "label": "Body", "fieldtype": "Small Text"},
    {"fieldname": "deeplink", "label": "Deeplink", "fieldtype": "Data"},
    {"fieldname": "col_2", "fieldtype": "Column Break"},
    {"fieldname": "reference_doctype", "label": "Reference DocType", "fieldtype": "Data"},
    {"fieldname": "reference_name", "label": "Reference Name", "fieldtype": "Data", "search_index": 1},
    {"fieldname": "dedup_key", "label": "Dedup Key", "fieldtype": "Data", "search_index": 1, "description": "Stable key for (notification, device). Guards against the sweeper double-sending."}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1}
  ],
  "sort_field": "creation",
  "sort_order": "DESC",
  "track_changes": 0
}
