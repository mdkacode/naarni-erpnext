{
  "name": "KM Monthly Adjustment",
  "module": "Fleet Service",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "field:row_key",
  "description": "One month-level Dead KM lump per vehicle. Subtracted from that vehicle's monthly billable KM, on top of any per-day Dead KM logged on Vehicle KM Daily.",
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "vehicle", "label": "Vehicle", "fieldtype": "Link", "options": "Vehicle", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "year_month", "label": "Month (YYYY-MM)", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "description": "The month this adjustment applies to, as YYYY-MM."},
    {"fieldname": "dead_km", "label": "Dead KM (deduct)", "fieldtype": "Float", "precision": "1", "in_list_view": 1, "description": "Non-billable KM to subtract from this vehicle's billable total for the month. Clamped so billable never goes below 0."},
    {"fieldname": "column_break_meta", "fieldtype": "Column Break"},
    {"fieldname": "row_key", "label": "Row Key", "fieldtype": "Data", "unique": 1, "read_only": 1, "hidden": 1},
    {"fieldname": "adjusted_by", "label": "Adjusted By", "fieldtype": "Link", "options": "User", "read_only": 1},
    {"fieldname": "adjusted_on", "label": "Adjusted On", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "section_notes", "fieldtype": "Section Break"},
    {"fieldname": "notes", "label": "Notes", "fieldtype": "Small Text"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Central Ops", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Depot Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Fleet Reports", "read": 1}
  ]
}
