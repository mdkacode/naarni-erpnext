<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (Android 12 / API 31+): cloud-backup and device-to-device
  transfer. Exclude the encrypted session store (auth token / device id) from both —
  see backup_rules.xml for the rationale.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="naarni_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="naarni_session.xml" />
    </device-transfer>
</data-extraction-rules>
