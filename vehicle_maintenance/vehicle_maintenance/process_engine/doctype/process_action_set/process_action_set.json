{
  "name": "Process Action Set",
  "module": "Process Engine",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "field:set_code",
  "track_changes": 1,
  "allow_import": 1,
  "description": "A named, reusable bundle of automations — e.g. 'Critical failure response': raise the NCR, notify the supervisor, quarantine the run. Steps link to one instead of repeating the same three rows twenty times, so changing who gets notified is a single edit.",
  "fields": [
    {
      "fieldname": "set_code",
      "label": "Set Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "set_name",
      "label": "Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "label": "When to use",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "column_break_meta",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "sb_actions",
      "label": "Actions",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "actions",
      "label": "Actions",
      "fieldtype": "Table",
      "options": "Process Step Action",
      "reqd": 1
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "import": 1},
    {"role": "Process Author", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "import": 1},
    {"role": "Process Operator", "read": 1},
    {"role": "Process Verifier", "read": 1},
    {"role": "Process Viewer", "read": 1}
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "set_name"
}
