{
  "name": "Observation Template",
  "module": "Fleet Service",
  "doctype": "DocType",
  "allow_import": 1,
  "engine": "InnoDB",
  "autoname": "OBS-.#####",
  "naming_rule": "Expression (old style)",
  "track_changes": 1,
  "description": "Canned SE/technician observation phrases that back the searchable observation/notes dropdown (replaces free-text where possible).",
  "fields": [
    {
      "fieldname": "observation_text",
      "label": "Observation",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "subsystem",
      "label": "Subsystem",
      "fieldtype": "Link",
      "options": "Subsystem",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "usage_count",
      "label": "Usage Count",
      "fieldtype": "Int",
      "read_only": 1,
      "default": "0"
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Depot Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Service Engineer", "read": 1, "create": 1},
    {"role": "Technician", "read": 1, "create": 1},
    {"role": "Central Ops", "read": 1}
  ],
  "sort_field": "usage_count",
  "sort_order": "DESC",
  "title_field": "observation_text"
}
