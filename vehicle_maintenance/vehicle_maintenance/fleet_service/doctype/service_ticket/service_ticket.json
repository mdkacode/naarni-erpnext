{
  "name": "Service Ticket",
  "module": "Fleet Service",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "TKT-.YYYY.-.#####",
  "track_changes": 1,
  "description": "An actionable ticket for a Service Engineer, auto-raised from an Alert Event for a bus at the engineer's depot (or created manually). Convertible into a Job Card.",
  "fields": [
    {"fieldname": "title", "label": "Title", "fieldtype": "Data", "in_list_view": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Open\nAcknowledged\nResolved", "default": "Open", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "severity", "label": "Severity", "fieldtype": "Select", "options": "\nLow\nMedium\nHigh\nCritical", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "source", "label": "Source", "fieldtype": "Select", "options": "Alert\nManual\nCustomer\nDriver", "default": "Alert", "in_standard_filter": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "vehicle", "label": "Vehicle", "fieldtype": "Link", "options": "Vehicle", "in_standard_filter": 1},
    {"fieldname": "registration_number", "label": "Registration No", "fieldtype": "Data", "in_list_view": 1},
    {"fieldname": "depot", "label": "Depot", "fieldtype": "Link", "options": "Depot", "in_standard_filter": 1},
    {"fieldname": "assigned_to", "label": "Assigned To", "fieldtype": "Link", "options": "User", "in_standard_filter": 1},
    {"fieldname": "sec_detail", "label": "Detail", "fieldtype": "Section Break"},
    {"fieldname": "message", "label": "Message", "fieldtype": "Small Text"},
    {"fieldname": "alert_event", "label": "Alert Event", "fieldtype": "Link", "options": "Alert Event", "read_only": 1},
    {"fieldname": "job_card", "label": "Job Card", "fieldtype": "Link", "options": "Job Card", "read_only": 1},
    {"fieldname": "deeplink", "label": "Deeplink", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "dedup_key", "label": "Dedup Key", "fieldtype": "Data", "read_only": 1, "hidden": 1},
    {"fieldname": "sec_location", "label": "Location", "fieldtype": "Section Break"},
    {"fieldname": "latitude", "label": "Latitude", "fieldtype": "Float", "precision": "6"},
    {"fieldname": "longitude", "label": "Longitude", "fieldtype": "Float", "precision": "6"},
    {"fieldname": "maps_link", "label": "Maps Link", "fieldtype": "Small Text"},
    {"fieldname": "sec_timeline", "label": "Timeline", "fieldtype": "Section Break"},
    {"fieldname": "acknowledged_at", "label": "Acknowledged At", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "resolved_at", "label": "Resolved At", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "resolution_reason", "label": "Resolution Reason", "fieldtype": "Small Text"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Depot Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Central Ops", "read": 1, "write": 1, "create": 1},
    {"role": "Service Engineer", "read": 1, "write": 1, "create": 1},
    {"role": "Aftersales Eng", "read": 1, "write": 1},
    {"role": "N. Maintenance Head", "read": 1, "write": 1}
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "title"
}
