{
  "name": "Depot",
  "module": "Fleet Service",
  "doctype": "DocType",
  "allow_import": 1,
  "document_type": "Document",
  "engine": "InnoDB",
  "autoname": "field:depot_name",
  "naming_rule": "By fieldname",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "depot_name",
      "label": "Depot Name",
      "fieldtype": "Data",
      "unique": 1,
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "location_code",
      "label": "Location Code",
      "fieldtype": "Data",
      "unique": 1,
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "length": 10,
      "description": "Short code used in Job Card naming series (e.g., BLR01). Uppercase alphanumeric."
    },
    {
      "fieldname": "city",
      "label": "City",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "state",
      "label": "State",
      "fieldtype": "Data"
    },
    {
      "fieldname": "address",
      "label": "Address",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "sec_geo",
      "label": "Location & Geofence",
      "fieldtype": "Section Break",
      "collapsible": 1,
      "description": "Used to judge whether a duty check-in happened at the depot. Leave the coordinates blank and this depot is never geofenced — check-ins still work, they simply carry no distance."
    },
    {
      "fieldname": "latitude",
      "label": "Latitude",
      "fieldtype": "Float",
      "precision": "6"
    },
    {
      "fieldname": "longitude",
      "label": "Longitude",
      "fieldtype": "Float",
      "precision": "6"
    },
    {
      "fieldname": "col_break_geo",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "geofence_radius_m",
      "label": "Geofence Radius (m)",
      "fieldtype": "Int",
      "description": "Leave 0 to use the default in Roster Settings."
    },
    {
      "fieldname": "sec_engineers",
      "label": "Service Engineers",
      "fieldtype": "Section Break",
      "description": "Engineers assigned to this depot — they receive its buses' alerts and tickets."
    },
    {
      "fieldname": "service_engineers",
      "label": "Assigned Service Engineers",
      "fieldtype": "Table MultiSelect",
      "options": "Depot Engineer"
    }
  ],
  "permissions": [
    {"role": "Depot Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Service Engineer", "read": 1},
    {"role": "Technician", "read": 1},
    {"role": "Central Ops", "read": 1}
  ],
  "sort_field": "depot_name",
  "sort_order": "ASC",
  "title_field": "depot_name"
}
