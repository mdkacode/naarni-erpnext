<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay. The release manifest keeps usesCleartextTraffic="false";
  here we swap in a config that allows cleartext to loopback only, so the app can
  reach a local bench over `adb reverse` during development.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
